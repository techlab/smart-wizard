{
    "name": "smart-wizard",
    "version": "0.1.0",
    "private": true,
    "description": "SmartWizard - A modern, framework-agnostic wizard/stepper component",
    "scripts": {
        "start": "turbo run dev --concurrency 12",
        "dev": "turbo run dev --concurrency 12",
        "dev:react": "turbo run dev --concurrency 12 --filter=@smartwizard/react",
        "dev:vanilla": "turbo run dev --concurrency 12 --filter=@smartwizard/vanilla --filter=@smartwizard/ui",
        "dev:vue": "turbo run dev --concurrency 12 --filter=@smartwizard/vue",
        "dev:ui": "turbo run dev --concurrency 12 --filter=@smartwizard/ui",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "test": "turbo run test"
    },
    "devDependencies": {
        "turbo": "^1.11.0"
    },
    "packageManager": "pnpm@8.15.0",
    "engines": {
        "node": ">=18.0.0",
        "pnpm": ">=8.0.0"
    }
}