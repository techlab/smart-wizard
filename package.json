{
    "name": "smart-wizard",
    "version": "1.0.0",
    "private": true,
    "description": "A modern, framework-agnostic wizard/stepper component",
    "scripts": {
        "start": "turbo run dev --concurrency 12",
        "dev": "turbo run dev --concurrency 12",
        "dev:react": "turbo run dev --concurrency 12 --filter=@smart-wizard/react",
        "dev:vanilla": "turbo run dev --concurrency 12 --filter=smartwizard-vanilla-example",
        "dev:vue": "turbo run dev --concurrency 12 --filter=@smart-wizard/vue",
        "dev:ui": "turbo run dev --concurrency 12 --filter=@smart-wizard/ui",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "test": "turbo run test"
    },
    "devDependencies": {
        "turbo": "^2.9.14"
    },
    "packageManager": "pnpm@8.15.0",
    "engines": {
        "node": ">=18.0.0",
        "pnpm": ">=8.0.0"
    }
}