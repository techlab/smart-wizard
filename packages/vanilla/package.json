{
    "name": "@smartwizard/vanilla",
    "version": "0.1.0",
    "description": "Vanilla JavaScript implementation of SmartWizard",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts --external @smartwizard/core",
        "dev": "tsup src/index.ts --format cjs,esm --watch"
    },
    "dependencies": {
        "@smartwizard/core": "workspace:*"
    },
    "devDependencies": {
        "tsup": "^8.0.0",
        "typescript": "^5.0.0"
    }
}