{
    "name": "@smart-wizard/core",
    "version": "1.0.0",
    "description": "Core logic for SmartWizard - modern, framework-agnostic wizard/stepper component",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts",
        "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
    },
    "keywords": [
        "form",
        "multi-step",
        "smartwizard",
        "stepper",
        "wizard"
    ],
    "author": "Dipu Rajendran",
    "license": "MIT",
    "devDependencies": {
        "tsup": "^8.0.0",
        "typescript": "^5.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/techlab/smart-wizard.git",
        "directory": "packages/core"
    },
    "homepage": "https://github.com/techlab/smart-wizard#readme",
    "bugs": {
        "url": "https://github.com/techlab/smart-wizard/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ]
}