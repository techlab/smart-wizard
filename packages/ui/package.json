{
    "name": "@smartwizard/ui",
    "version": "0.1.0",
    "description": "Core styles for SmartWizard - framework-agnostic wizard component",
    "style": "dist/smartwizard.css",
    "main": "dist/smartwizard.css",
    "exports": {
        ".": {
            "style": "./dist/smartwizard.css"
        },
        "./dist/*": "./dist/*"
    },
    "scripts": {
        "build": "sass src/main.scss dist/smartwizard.css --no-source-map && sass src/main.scss dist/smartwizard.min.css --style=compressed --no-source-map",
        "dev": "sass --watch src/main.scss dist/smartwizard.css"
    },
    "keywords": [
        "wizard",
        "stepper",
        "form",
        "multi-step",
        "styles",
        "css",
        "scss"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "sass": "^1.70.0"
    }
}