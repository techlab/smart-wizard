{
    "name": "@smartwizard/ui",
    "version": "0.1.0",
    "description": "Core styles for SmartWizard - framework-agnostic wizard component",
    "style": "dist/smartwizard.css",
    "main": "dist/smartwizard.css",
    "exports": {
        ".": {
            "style": "./dist/smartwizard.css"
        },
        "./themes/basic": {
            "style": "./dist/themes/basic.css"
        },
        "./themes/arrows": {
            "style": "./dist/themes/arrows.css"
        },
        "./themes/pills": {
            "style": "./dist/themes/pills.css"
        },
        "./themes/glow": {
            "style": "./dist/themes/glow.css"
        },
        "./themes/simple": {
            "style": "./dist/themes/simple.css"
        },
        "./themes/vertical": {
            "style": "./dist/themes/vertical.css"
        },
        "./themes/dots": {
            "style": "./dist/themes/dots.css"
        },
        "./themes/slide": {
            "style": "./dist/themes/slide.css"
        },
        "./dist/*": "./dist/*"
    },
    "scripts": {
        "build": "sass src/main.scss dist/smartwizard.css --no-source-map && sass src/main.scss dist/smartwizard.min.css --style=compressed --no-source-map && sass --load-path=src src/entries/basic.scss:dist/themes/basic.css src/entries/arrows.scss:dist/themes/arrows.css src/entries/pills.scss:dist/themes/pills.css src/entries/glow.scss:dist/themes/glow.css src/entries/simple.scss:dist/themes/simple.css src/entries/dots.scss:dist/themes/dots.css src/entries/slide.scss:dist/themes/slide.css --no-source-map",
        "build:themes": "sass --load-path=src src/entries/basic.scss:dist/themes/basic.css src/entries/arrows.scss:dist/themes/arrows.css src/entries/pills.scss:dist/themes/pills.css src/entries/glow.scss:dist/themes/glow.css src/entries/simple.scss:dist/themes/simple.css src/entries/dots.scss:dist/themes/dots.css src/entries/slide.scss:dist/themes/slide.css --no-source-map",
        "dev": "sass --watch src/main.scss dist/smartwizard.css"
    },
    "keywords": [
        "wizard",
        "stepper",
        "form",
        "multi-step",
        "styles",
        "css",
        "scss"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "sass": "^1.70.0"
    }
}