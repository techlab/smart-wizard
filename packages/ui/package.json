{
    "name": "@smart-wizard/ui",
    "version": "1.0.3",
    "description": "Core styles for SmartWizard - framework-agnostic wizard component",
    "style": "dist/smartwizard.css",
    "main": "dist/smartwizard.css",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "import": "./dist/smartwizard.css",
            "style": "./dist/smartwizard.css",
            "default": "./dist/smartwizard.css"
        },
        "./full": {
            "import": "./dist/smartwizard-full.css",
            "style": "./dist/smartwizard-full.css",
            "default": "./dist/smartwizard-full.css"
        },
        "./themes/*": {
            "import": "./dist/themes/*.css",
            "style": "./dist/themes/*.css",
            "default": "./dist/themes/*.css"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "LICENSE-COMMERCIAL.md"
    ],
    "sideEffects": [
        "*.css"
    ],
    "scripts": {
        "build:core": "sass src/core.scss dist/smartwizard.css && postcss dist/smartwizard.css -u autoprefixer cssnano -o dist/smartwizard.min.css --no-map",
        "build:full": "sass src/full.scss dist/smartwizard-full.css && postcss dist/smartwizard-full.css -u autoprefixer cssnano -o dist/smartwizard-full.min.css --no-map",
        "build:themes": "sass --load-path=src src/themes:dist/themes && postcss \"dist/themes/*.css\" !\"dist/themes/*.min.css\" -u autoprefixer cssnano --dir dist/themes --ext .min.css --no-map",
        "build": "pnpm run build:core && pnpm run build:full && pnpm run build:themes",
        "dev": "sass --watch src/core.scss:dist/smartwizard.css src/full.scss:dist/smartwizard-full.css src/themes:dist/themes"
    },
    "keywords": [
        "styles",
        "css",
        "scss",
        "wizard",
        "step-wizard",
        "stepper",
        "steps",
        "form",
        "forms",
        "form-wizard",
        "multi-step",
        "multi-step-form",
        "onboarding",
        "user-interface"
    ],
    "author": {
        "name": "Dipu Rajendran",
        "email": "hello.techlab@gmail.com",
        "url": "https://github.com/techlab"
    },
    "license": "(GPL-3.0-or-later OR LicenseRef-commercial)",
    "devDependencies": {
        "autoprefixer": "^10.5.0",
        "cssnano": "^7.1.9",
        "postcss": "^8.5.14",
        "postcss-cli": "^11.0.1",
        "sass": "^1.70.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/techlab/smart-wizard.git",
        "directory": "packages/ui"
    },
    "homepage": "https://techlaboratory.net/smart-wizard",
    "bugs": {
        "url": "https://github.com/techlab/smart-wizard/issues"
    }
}