{
    "name": "@smartwizard/ui-tailwind",
    "version": "0.1.0",
    "description": "Tailwind CSS theme for SmartWizard",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts",
        "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
    },
    "dependencies": {
        "@smartwizard/core": "workspace:*"
    },
    "devDependencies": {
        "tailwindcss": "^3.4.0",
        "tsup": "^8.0.0",
        "typescript": "^5.0.0"
    }
}