{
    "name": "@smart-wizard/extension-url-hash",
    "version": "1.0.1",
    "description": "URL hash + browser history navigation extension for SmartWizard",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts --external @smart-wizard/core",
        "dev": "tsup src/index.ts --format cjs,esm --dts --watch --external @smart-wizard/core"
    },
    "keywords": [
        "extension",
        "history",
        "smartwizard",
        "url-hash",
        "wizard",
        "step-wizard",
        "stepper",
        "steps",
        "form",
        "forms",
        "form-wizard",
        "multi-step",
        "multi-step-form",
        "onboarding",
        "user-interface",
        "react",
        "reactjs",
        "react-stepper",
        "vue",
        "vuejs",
        "vue-stepper",
        "zero-dependencies",
        "component",
        "components",
        "javascript",
        "typescript"
    ],
    "license": "(GPL-3.0-or-later OR LicenseRef-commercial)",
    "peerDependencies": {
        "@smart-wizard/core": ">=1.0.1"
    },
    "devDependencies": {
        "@smart-wizard/core": "workspace:*",
        "tsup": "^8.0.0",
        "typescript": "^5.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/techlab/smart-wizard.git",
        "directory": "packages/extensions/url-hash"
    },
    "homepage": "https://techlaboratory.net/smart-wizard",
    "bugs": {
        "url": "https://github.com/techlab/smart-wizard/issues"
    },
    "author": {
        "name": "Dipu Rajendran",
        "email": "hello.techlab@gmail.com",
        "url": "https://github.com/techlab"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "LICENSE-COMMERCIAL.md"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    }
}