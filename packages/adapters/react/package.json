{
    "name": "@smartwizard/react",
    "version": "0.1.0",
    "description": "React bindings for SmartWizard",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts --external @smartwizard/core --external react",
        "dev": "tsup src/index.ts --format cjs,esm --watch"
    },
    "dependencies": {
        "@smartwizard/core": "workspace:*"
    },
    "peerDependencies": {
        "react": "^18.0.0"
    },
    "devDependencies": {
        "@types/react": "^18.0.0",
        "react": "^18.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.0.0"
    }
}