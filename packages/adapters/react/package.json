{
    "name": "@smart-wizard/react",
    "version": "1.0.1",
    "description": "React bindings for SmartWizard - modern, framework-agnostic wizard/stepper component",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts --external @smart-wizard/core --external react",
        "dev": "tsup src/index.ts --format cjs,esm --watch"
    },
    "dependencies": {
        "@smart-wizard/core": "workspace:*"
    },
    "peerDependencies": {
        "react": "^18.0.0"
    },
    "devDependencies": {
        "@types/react": "^18.0.0",
        "react": "^18.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/techlab/smart-wizard.git",
        "directory": "packages/adapters/react"
    },
    "homepage": "https://github.com/techlab/smart-wizard#readme",
    "bugs": {
        "url": "https://github.com/techlab/smart-wizard/issues"
    },
    "author": {
        "name": "Dipu Rajendran",
        "email": "hello.techlab@gmail.com",
        "url": "https://github.com/techlab"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "keywords": [
        "wizard",
        "stepper",
        "form",
        "multi-step",
        "react",
        "smartwizard"
    ]
}